{
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js?__p=/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "/api/index.js?__p=/healthz"
    },
    {
      "source": "/login",
      "destination": "/auth.html"
    },
    {
      "source": "/register",
      "destination": "/auth.html"
    },
    {
      "source": "/verify-email",
      "destination": "/auth.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/auth.html"
    },
    {
      "source": "/reset-password",
      "destination": "/auth.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/trade",
      "destination": "/trade.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "db/schema.postgres.sql"
    }
  },
  "redirects": [
    {
      "source": "/start-login",
      "destination": "/login"
    }
  ]
}
